# Optional: Permanent Cloudflare Named Tunnel (for paid/custom Cloudflare domains)
# Option A: Token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# PLURE_CF_TUNNEL_TOKEN=
# PLURE_CF_PUBLIC_URL=https://plure.yourdomain.com

# Option B: Local cloudflared login (`cloudflared tunnel login`)
# PLURE_CF_TUNNEL_NAME=plure
# PLURE_CF_CONFIG_PATH=C:\Users\fauza\.cloudflared\plure.yml
# PLURE_CF_PUBLIC_URL=https://plure.yourdomain.com
